nextflow_pipeline {

    name "Test Workflow main.nf - BCLCONVERT"
    script "../main.nf"
    profile "test"
    
        def test_scenarios = [
        [
            name: "BCL-CONVERT",
            tag: "bclconvert"
        ]
    ]
    
    test_scenarios.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}