def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test publish only trimmed FASTQs"
    script "../main.nf"
    profile "test"

        def test_scenarios = [
        [
            name: "Publish only trimmed",
            tag: "bclconvert",
            params: [
                input: "${projectDir}/tests/trimming/remove_samplesheet_adapter/samplesheets/input_samplesheet.csv",
                publish_raw_fastq: false,
                trim_fastq: true,
            ]
        ]
    ]

    test_scenarios.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
