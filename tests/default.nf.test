nextflow_pipeline {

    name "Test Workflow main.nf - BASES2FASTQ"
    script "../main.nf"
    profile "test_bases2fastq"

        def test_scenarios = [
        [
            name: "Bases2Fastq",
            tag: "bases2fastq"
        ]
    ]

    test_scenarios.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
