                """
                input[0] = channel.of([[id:'Sample1_S1_L001', samplename:'Sample1_atacseq', fcid:'220422_M11111_0222_000000000-K9H97', lane:'1', empty:false, single_end:false, fastq_1:'Sample1_S1_L001_R1_001.fastq.gz', fastq_2:'Sample1_S1_L001_R2_001.fastq.gz']])
