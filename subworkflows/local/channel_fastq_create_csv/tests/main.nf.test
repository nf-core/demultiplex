            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out)).match() }
            )
        }
    }

    test("Should produce valid CSV with mixed single-end and paired-end samples") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [id:'SampleA_S1_L001', samplename:'SampleA', fcid:'220422_M11111_0222_000000000-K9H97', lane:'1', empty:false, single_end:true, fastq_1:'SampleA_S1_L001_R1_001.fastq.gz'],
                    [id:'SampleB_S1_L001', samplename:'SampleB', fcid:'220422_M11111_0222_000000000-K9H97', lane:'1', empty:false, single_end:false, fastq_1:'SampleB_S1_L001_R1_001.fastq.gz', fastq_2:'SampleB_S1_L001_R2_001.fastq.gz']
                )
                input[1] = ['rnaseq']
                input[2] = 'auto'
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                {
                    def samplesheet = path(workflow.out.samplesheet.get(0))
                    with(samplesheet.csv) {
                        assert snapshot(
                            samplesheet,
                            "headers:" + columnNames,
                            "rowCount:" + rowCount,
                            "columnCount:" + columnCount
                        ).match()
                    }
                }
            )
        }
    }
}
